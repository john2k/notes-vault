# Optional Bearer token for HomeHub / external widgets (quick-capture, embeds).
# Jeton Bearer optionnel pour HomeHub / widgets externes (quick-capture, embeds).
HOMEHUB_API_TOKEN=

# Local port override (optional)
# Port local optionnel
# PORT=3000

# Backup script paths (used by scripts/backup-sync.sh on the LXC host)
# Chemins backup (utilisés par scripts/backup-sync.sh sur le LXC)
VAULT_DIR=/opt/notes-vault/vault
UNRAID_BACKUP_MOUNT=/mnt/unraid_backups/notes
RCLONE_REMOTE=gdrive_encrypted:NotesVault
